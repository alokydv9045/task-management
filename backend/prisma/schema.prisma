// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String?  @unique
  isGuest   Boolean  @default(false)
  avatarUrl String?
  createdAt DateTime @default(now())
  
  // Relations
  createdTasks Task[] @relation("CreatedTasks")
  assignedTasks Task[] @relation("AssignedTasks")
  comments     Comment[]
  auditLogs    AuditLog[]
}

model Task {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      String   @default("TODO") // TODO, DOING, COMPLETED, ON_HOLD
  priority    String   @default("LOW")  // HIGH, MEDIUM, LOW
  dueDate     DateTime?
  labels      String?  // Stored as JSON string or comma-separated
  order       Int      @default(0)
  
  creatorId   String   @db.ObjectId
  creator     User     @relation("CreatedTasks", fields: [creatorId], references: [id])
  
  assigneeId  String?  @db.ObjectId
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])

  parentId    String?  @db.ObjectId
  parent      Task?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks    Task[]   @relation("Subtasks")

  comments    Comment[]
  history     AuditLog[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g., "changed priority from Low to High"
  createdAt DateTime @default(now())
}
